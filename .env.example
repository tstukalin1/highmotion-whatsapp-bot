# ============================================================
# WhatsApp AI Bot — Environment Variables
# Copy to .env and fill in all <<PLACEHOLDER>> values.
# Never commit .env to version control!
# ============================================================


# ── WhatsApp Business API ────────────────────────────────────
# From Meta Developer Console → Your App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=<<WHATSAPP_ACCESS_TOKEN>>
WHATSAPP_PHONE_NUMBER_ID=<<WHATSAPP_PHONE_NUMBER_ID>>
WHATSAPP_VERIFY_TOKEN=<<WHATSAPP_VERIFY_TOKEN>>
# App Secret from Meta App Settings → Basic → App Secret
WHATSAPP_APP_SECRET=<<WHATSAPP_APP_SECRET>>


# ── Anthropic / Claude ────────────────────────────────────────
# From console.anthropic.com → API Keys
ANTHROPIC_API_KEY=<<ANTHROPIC_API_KEY>>
# Model to use. Options: claude-haiku-4-5-20251001 | claude-sonnet-4-6 | claude-opus-4-6
CLAUDE_MODEL=claude-haiku-4-5-20251001


# ── Database ──────────────────────────────────────────────────
# SQLite (default, development):
DATABASE_URL=sqlite:///./whatsapp_bot.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_bot


# ── Payments ──────────────────────────────────────────────────
# "auto" = confirm on webhook, "manual" = admin confirms via API
PAYMENT_CONFIRMATION_MODE=manual

# Secret used to verify payment webhook signatures
PAYMENT_WEBHOOK_SECRET=<<PAYMENT_WEBHOOK_SECRET>>

# Provider-specific payment details:
# SBP: leave as <<>> and fill SBP_* vars in qr.py / PLACEHOLDERS.md
# Stripe: paste your Payment Link URL here
# Generic: any payment instruction string
PAYMENT_DETAILS=<<PAYMENT_DETAILS>>

# Payment provider: sbp | stripe | generic
PAYMENT_PROVIDER=<<PAYMENT_PROVIDER>>

# Percent of total price required as prepayment (default 30)
PREPAYMENT_PERCENT=30

# Minutes before unpaid booking expires (default 60)
PAYMENT_TIMEOUT=60


# ── Admin ─────────────────────────────────────────────────────
# Strong random token for admin API authentication
ADMIN_API_TOKEN=<<ADMIN_API_TOKEN>>


# ── Manager Contacts ──────────────────────────────────────────
# WhatsApp number in international format (no + or spaces)
MANAGER_PHONE=<<MANAGER_PHONE>>
MANAGER_EMAIL=<<MANAGER_EMAIL>>


# ── Business Info ─────────────────────────────────────────────
BUSINESS_NAME=<<BUSINESS_NAME>>
# Primary language for AI responses: ru | en | etc.
MAIN_LANGUAGE=ru
# Country / legal jurisdiction for GDPR/legal notices
LEGAL_REGION=<<LEGAL_REGION>>


# ── WhatsApp Approved Templates ───────────────────────────────
# Template names as approved in WhatsApp Business Manager
WA_TEMPLATE_PAYMENT_REMINDER=<<WA_TEMPLATE_PAYMENT_REMINDER>>
WA_TEMPLATE_BOOKING_CONFIRMED=<<WA_TEMPLATE_BOOKING_CONFIRMED>>


# ── Feature Flags ─────────────────────────────────────────────
# Set to true in development to allow unsubstituted placeholders
DEV_MODE=false


# ── Rate Limiting ─────────────────────────────────────────────
MAX_MESSAGES_CONTEXT=20
RATE_LIMIT_PER_HOUR=30


# ── Logging ───────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
